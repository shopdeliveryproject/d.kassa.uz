# Vercel'da "Storage -> Postgres (Neon)" qo'shsangiz, bu qiymat
# avtomatik environment variable sifatida qo'shiladi (POSTGRES_URL).
# Mahalliy kompyuterda ishlatish uchun uni shu yerga qo'lda nusxalang.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require

# O'zingiz o'ylab topgan uzun, tasodifiy maxfiy matn
JWT_SECRET=bu_yerga_uzun_tasodifiy_maxfiy_matn_yozing
JWT_EXPIRES_IN=7d

# Faqat "npm run seed" birinchi marta ishga tushganda ishlatiladi
SEED_ADMIN_LOGIN=imradjabov
SEED_ADMIN_PASSWORD=zdrrgb12
SEED_ADMIN_NAME=Imran Radjabov

# Faqat rasm/fayl saqlash (Supabase Storage) uchun.
# Baza (Postgres) bilan bog'liq emas -- u yuqoridagi POSTGRES_URL orqali ishlaydi.
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sizning_service_role_kalitingiz
